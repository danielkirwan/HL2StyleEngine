<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="HS2 QA">
  <Profiles>
    <SystemCollector Id="HS2Scheduler" Name="HS2 Scheduling Collector">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </SystemCollector>
    <SystemProvider Id="HS2SchedulerEvents">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
        <Keyword Value="HardFaults" />
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>
    <Profile Id="HS2Scheduling.Verbose.File" Name="HS2Scheduling" Description="Bounded engine scheduling diagnosis" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="HS2Scheduler">
          <SystemProviderId Value="HS2SchedulerEvents" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
