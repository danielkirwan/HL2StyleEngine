<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TraceEventDirectory Condition="'$(TraceEventDirectory)' == ''">../../.dotnet/diagnostics/.store/dotnet-gcdump/10.0.750501/dotnet-gcdump/10.0.750501/tools/net8.0/any</TraceEventDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Diagnostics.Tracing.TraceEvent">
      <HintPath>$(TraceEventDirectory)/Microsoft.Diagnostics.Tracing.TraceEvent.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Diagnostics.FastSerialization">
      <HintPath>$(TraceEventDirectory)/Microsoft.Diagnostics.FastSerialization.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="CheckTraceEvent" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TraceEventDirectory)/Microsoft.Diagnostics.Tracing.TraceEvent.dll')" Text="Set TraceEventDirectory to the installed dotnet-gcdump tool directory. This offline QA helper is not a game dependency." />
  </Target>
</Project>
