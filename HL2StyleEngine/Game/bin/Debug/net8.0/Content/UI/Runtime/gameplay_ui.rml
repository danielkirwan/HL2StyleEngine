<rml>
  <head>
    <title>Gameplay UI</title>
    <link type="text/rcss" href="../Inventory/inventory.rcss" />
  </head>
  <body>
    <div id="gameplay-root">
      <section id="pause-panel" class="modal-card">
        <div class="pause-title"><img class="ui-text-image ui-text-title" src="Text/96db4ca2b4707580.png" width="116" height="41" /></div>
        <div class="pause-subtitle"><img class="ui-text-image ui-text-subtitle" src="Text/7f436b34a0b112d5.png" width="114" height="18" /></div>
        <div id="pause-menu-list">
          <div class="pause-menu-row selected" data-slot="0" style="top: 0px;"><img class="ui-text-image ui-text-menu" src="Text/437d312d099cd1c4.png" width="68" height="24" /></div>
          <div class="pause-menu-row" data-slot="1" style="top: 54px;"><img class="ui-text-image ui-text-menu" src="Text/e086ce84ecf3cd45.png" width="92" height="24" /></div>
        </div>
        <div class="pause-footer"><img class="ui-text-image ui-text-footer" src="Text/3f742b839928ee7c.png" width="458" height="17" /></div>
      </section>
    </div>
  </body>
</rml>
