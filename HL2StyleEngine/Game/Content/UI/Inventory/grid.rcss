#inventory-grid-overlay {
  position: absolute;
  left: 0px; top: 0px; width: 100%; height: 100%;
  background-color: rgba(0, 0, 0, 0.62);
  color: #e8e8e8;
  letter-spacing: 0px;
}
.grid-label { position: absolute; font-size: 14px; letter-spacing: 0px; }
.grid-cell { position: absolute; box-sizing: border-box; border: 1px rgba(139, 139, 139, 0.54); background-color: rgba(20, 20, 20, 0.4); }
.grid-item { position: absolute; box-sizing: border-box; background-color: rgba(29, 29, 29, 0.8); border: 1px #777777; pointer-events: none; }
.grid-item.selected { border: 2px #e8e8e8; }
.grid-item.combine-valid { border: 2px #8dcf82; }
.grid-item.combine-source { border: 2px #e8cc70; }
.grid-sprite { position: absolute; pointer-events: none; }
.grid-count { position: absolute; bottom: 3px; right: 5px; color: #e8cc70; font-size: 15px; pointer-events: none; }
.grid-fallback { position: absolute; left: 4px; top: 8px; font-size: 12px; overflow: hidden; pointer-events: none; }
.grid-focus { position: absolute; box-sizing: border-box; border: 2px #8dcf82; pointer-events: none; }
.grid-focus.invalid { border-color: #ef6464; }
.grid-description { position: absolute; height: 112px; overflow: hidden; pointer-events: none; }
.grid-description h2 { font-size: 16px; margin: 0px 0px 8px 0px; letter-spacing: 0px; color: #e8e8e8; }
.grid-description p { font-size: 14px; margin: 0px; color: #aaaaaa; }
#inventory-grid-overlay .floating-menu { right: auto; bottom: auto; margin: 0px; height: 300px; background-color: #191919; border-color: #aaaaaa; }
#inventory-grid-overlay .action-row { box-sizing: border-box; height: 32px; background-color: #242424; border-color: #666666; }
#inventory-grid-overlay .menu-footer { display: none; }
#inventory-grid-overlay .menu-title { letter-spacing: 0px; }
